# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — lokalno (SQLite) ili produkcija (Turso)
# Lokalno:
DATABASE_URL="file:./dev.db"
# Produkcija (Turso):
# DATABASE_URL="libsql://[tvoja-baza].turso.io"
# DATABASE_AUTH_TOKEN="[token]"

# Auth — u produkciji postavi SNAŽAN nasumičan ključ!
JWT_SECRET=your_jwt_secret

# Admin email (email-OTP prijava — nema trajne lozinke)
ADMIN_EMAIL=gdjevecerasbusiness@gmail.com

# Vercel Blob (upload slika u produkciji; bez ovoga upload ide na lokalni disk)
BLOB_READ_WRITE_TOKEN=

# Email (SMTP) — npr. Resend, Brevo, Gmail SMTP
# Bez ovih varijabli email radi u "terminal modu" (link se ispisuje u konzolu)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=gdjevecerasbusiness@gmail.com

# PAYPAL
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_client_secret
PAYPAL_WEBHOOK_ID=your_webhook_id
PAYPAL_ENVIRONMENT=sandbox # or live
