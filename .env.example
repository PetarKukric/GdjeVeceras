# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — lokalno (SQLite) ili produkcija (Turso)
# Lokalno:
DATABASE_URL="file:./dev.db"
# Produkcija (Turso):
# DATABASE_URL="libsql://[tvoja-baza].turso.io"
# DATABASE_AUTH_TOKEN="[token]"

# Auth — u produkciji postavi SNAŽAN nasumičan ključ!
JWT_SECRET=your_jwt_secret

# Večeras Score: tajna za potpisivanje QR check-in kodova (opciono — bez nje se koristi JWT_SECRET).
# Promjena ove vrijednosti poništava SVE odštampane QR kodove.
CHECKIN_SECRET=

# Google prijava (opciono — bez ovoga dugme javlja da Google prijava nije podešena)
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: https://gdjeveceras.com/api/auth/google/callback  (lokalno: http://localhost:3000/api/auth/google/callback)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Admin email (email-OTP prijava — nema trajne lozinke)
ADMIN_EMAIL=gdjevecerasbusiness@gmail.com

# Vercel Blob (upload slika u produkciji; bez ovoga upload ide na lokalni disk)
BLOB_READ_WRITE_TOKEN=

# Email (SMTP) — npr. Resend, Brevo, Gmail SMTP
# Bez ovih varijabli email radi u "terminal modu" (link se ispisuje u konzolu)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=gdjevecerasbusiness@gmail.com

# PAYPAL
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_client_secret
PAYPAL_WEBHOOK_ID=your_webhook_id
PAYPAL_ENVIRONMENT=sandbox # or live

# Samo za razvoj: `npm run dev` automatski prijavljuje ovaj nalog (bez lozinke).
# Prazno = lokalni "Dev Admin" (dev@gdjeveceras.local). U produkciji se ignoriše.
DEV_LOGIN_EMAIL=
